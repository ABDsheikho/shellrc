#!/bin/bash

osc7_cwd() {
    # Encode path bytes, not characters. OSC 7 carries a URI, so non-ASCII
    # bytes must be percent-encoded; a UTF-8 locale would otherwise make
    # ${PWD:$pos:1} return whole characters and printf emit raw UTF-8.
    local LC_ALL=C
    local strlen=${#PWD}
    local encoded=""
    local pos c o
    for ((pos = 0; pos < strlen; pos++)); do
        c=${PWD:$pos:1}
        case "$c" in
        [-/:_.!\'\(\)~[:alnum:]]) o="${c}" ;;
        *) printf -v o '%%%02X' "'${c}" ;;
        esac
        encoded+="${o}"
    done
    printf '\e]7;file://%s%s\e\\' "${HOSTNAME}" "${encoded}"
}
if [[ -n ${PROMPT_COMMAND[*]:-} ]]; then
    PROMPT_COMMAND=("${PROMPT_COMMAND[@]}")
fi
[[ " ${PROMPT_COMMAND[*]} " == *" osc7_cwd "* ]] || PROMPT_COMMAND+=("osc7_cwd")

prompt_marker() {
    printf '\e]133;A\e\\'
}
[[ " ${PROMPT_COMMAND[*]} " == *" prompt_marker "* ]] || PROMPT_COMMAND+=("prompt_marker")
