#!/bin/bash

# ==============================================================================
# SHELL BEHAVIOR & INTERACTIVE CHECK
# ==============================================================================

# Check window size after each command; update LINES and COLUMNS if needed
shopt -s checkwinsize

# Correct minor spelling errors in directory names during 'cd'
shopt -s cdspell

# Enable extended globbing (e.g., ls **/*.js)
shopt -s globstar

# ==============================================================================
# ENHANCED TERMINAL HISTORY
# ==============================================================================
# Ignore consecutive duplicates and commands starting with a space
export HISTCONTROL=ignoreboth
export HISTIGNORE='cd *'
export HISTTIMEFORMAT='%Y-%m-%dT%H:%M:%S  '

# Large history, same limit in memory and on disk
export HISTSIZE=100000
export HISTFILESIZE=100000

# Append to history file immediately; do not overwrite it on exit
shopt -s histappend

# A workaround the old way of
# export PROMPT_COMMAND="history -a; history -c; history -r; $PROMPT_COMMAND"
__bash_history_sync() {
    history -a # flush this shell's new entries
    history -n # read only entries added by other shells
}

# PROMPT_COMMAND is an array in bash 5.1+ and in /etc/bash.bashrc.
# Keep existing hooks and fold __bash_history_sync into the first element.
#
# Design constraint: starship's bash init preserves only element 0:
#   STARSHIP_PROMPT_COMMAND="$PROMPT_COMMAND"  # expands element 0 only
#   PROMPT_COMMAND="starship_precmd"
# starship_precmd later evals STARSHIP_PROMPT_COMMAND. Hooks in later elements
# still run as array elements today, but they are outside starship's captured
# chain, so a hook that must survive starship belongs in element 0.
if [[ -n ${PROMPT_COMMAND[*]:-} ]]; then
    PROMPT_COMMAND=("${PROMPT_COMMAND[@]}")
else
    PROMPT_COMMAND=()
fi
if [[ " ${PROMPT_COMMAND[*]} ${STARSHIP_PROMPT_COMMAND:-} " != *" __bash_history_sync "* ]]; then
    if [[ ${#PROMPT_COMMAND[@]} -eq 0 ]]; then
        PROMPT_COMMAND=("__bash_history_sync")
    else
        PROMPT_COMMAND[0]="${PROMPT_COMMAND[0]:+${PROMPT_COMMAND[0]}; }__bash_history_sync"
    fi
fi
