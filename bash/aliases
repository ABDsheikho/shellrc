#!/bin/bash

# ==============================================================================
# Aliases
# ==============================================================================

alias gitshallowclone='git clone --depth=1'
alias dotfiles="git --git-dir=$HOME/.dotfiles/ --work-tree=$HOME"

alias cyc='cat /sys/class/power_supply/BAT0/cycle_count'
alias cap='cat /sys/class/power_supply/BAT0/capacity'

# Use a custom dircolors database only when one exists
if command -v dircolors >/dev/null 2>&1 && [[ -r $HOME/.dircolors ]]; then
    eval "$(dircolors -b "$HOME/.dircolors")"
fi

# Enable colored output for common terminal commands
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias diff='diff --color=auto'

# Navigation shortcuts
alias cdh='cd ~'

# Better directory listings
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Safety guardrails (prompts before destructive operations)
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

alias myip='curl -s https://ifconfig.me; printf "\n"' # Quickly find public IP

# Reload the shell with a fresh .bashrc
alias srcbashrc='exec bash'

# Show top 25 file/directory under current directory, sorted by largest
alias bfile='du -ah . | sort -hr | head -n 25'

# ==============================================================================
# Functions
# ==============================================================================

# Print PATH entries line-by-line without spawning a subprocess
path() {
    printf '%s\n' "${PATH//:/$'\n'}"
}

# Smart Archive Extractor (handles almost all zip/tar extensions)
extract() {
    if [[ -f $1 ]]; then
        case "$1" in
        *.tar.bz2) tar xjf "$1" ;;
        *.tar.gz) tar xzf "$1" ;;
        *.bz2) bunzip2 "$1" ;;
        *.rar) unrar x "$1" ;;
        *.gz) gunzip "$1" ;;
        *.tar) tar xf "$1" ;;
        *.tbz2) tar xjf "$1" ;;
        *.tgz) tar xzf "$1" ;;
        *.zip) unzip "$1" ;;
        *.Z) uncompress "$1" ;;
        *.7z) 7z x "$1" ;;
        *) printf "'%s' cannot be extracted via extract()\n" "$1" ;;
        esac
    else
        printf "'%s' is not a valid file\n" "$1"
    fi
}

# Create a directory and immediately move into it
mkcd() {
    mkdir -p "$1" && cd "$1"
}

fpac() {
    pacman -Sl |
        awk '{print $2}' |
        fzf --preview='pacman -Si {}' \
            --preview-window='right:70%' \
            --height=75% |
        xargs -rI {} pacman -Si {}
}

fman() {
    # find /usr/share/man/man* -type f,l -printf "%f\n"

    find /usr/share/man/man* -type f,l -exec bash -c 'for f; do name="${f##*/}"; printf "%s\n" "${name%.*}"; done' _ {} + |

        # find /usr/share/man/man* -type f,l |
        #     awk -F/ '{print $NF}' |
        #     sed 's/\.[^.]*$//' |
        fzf --preview='man {}' \
            --preview-window='right:70%' \
            --height=85% |
        xargs -rI {} man {}
}

# Delete selected history entries from both this shell and $HISTFILE
dhist() {
    local selected line n count
    local -a nums

    [[ -n ${HISTFILE:-} ]] || {
        printf 'dhist: HISTFILE is not set\n' >&2
        return 1
    }

    command -v fzf >/dev/null 2>&1 || {
        printf 'dhist: fzf not found\n' >&2
        return 1
    }

    # Make this shell's history as current as possible before showing it.
    history -a
    history -n

    selected=$(
        HISTTIMEFORMAT= history |
            fzf --multi --tac --no-sort \
                --prompt='entry> ' \
                --header='Tab: select | Enter: delete | Esc: cancel'
    ) || return

    [[ -n $selected ]] || return

    # fzf lines look like: "  123  command"
    while IFS= read -r line; do
        [[ $line =~ ^[[:space:]]*([0-9]+) ]] || continue
        nums+=("${BASH_REMATCH[1]}")
    done <<<"$selected"

    count=${#nums[@]}
    ((count)) || return

    # `IFS= read -r n` reads one line into `n`. IFS= prevents field
    # splitting/trimming and -r disables backslash escaping, so each line
    # is taken literally. Here each line is one numeric history offset.
    # They are sorted in reverse numeric order so the highest offset is
    # removed first: `history -d` renumbers the entries after the deleted
    # one, so deleting from the end keeps every remaining offset valid.
    # The loop runs in the current shell, not a subshell, so each
    # `history -d` affects the history that `history -w` writes.
    while IFS= read -r n; do
        history -d "$n" || {
            # Stop on the first failure and leave $HISTFILE untouched rather
            # than rewriting it from a partially updated history.
            printf 'dhist: failed to delete entry %s\n' "$n" >&2
            return 1
        }
    done < <(printf '%s\n' "${nums[@]}" | sort -rn)

    # Keep entries other shells appended while the picker was open.
    history -n

    # Rewrite $HISTFILE from the updated in-memory history. This makes the
    # deletions persistent in the file, not just in the picker. Other shells
    # can still race, so this is not an atomic multi-shell edit.
    history -w || {
        printf 'dhist: failed to write %s\n' "$HISTFILE" >&2
        return 1
    }

    if ((count == 1)); then
        printf 'Deleted 1 history entry from %s\n' "$HISTFILE"
    else
        printf 'Deleted %d history entries from %s\n' "$count" "$HISTFILE"
    fi
}
