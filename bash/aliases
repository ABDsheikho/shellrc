#!/bin/bash

# ==============================================================================
# Aliases
# ==============================================================================

alias gitshallowclone='git clone --depth=1'
alias dotfiles="git --git-dir=$HOME/.dotfiles/ --work-tree=$HOME"

alias cyc='cat /sys/class/power_supply/BAT0/cycle_count'
alias cap='cat /sys/class/power_supply/BAT0/capacity'

# Use a custom dircolors database only when one exists
if command -v dircolors >/dev/null 2>&1 && [[ -r $HOME/.dircolors ]]; then
    eval "$(dircolors -b "$HOME/.dircolors")"
fi

# Enable colored output for common terminal commands
alias ls='ls --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias diff='diff --color=auto'

# Navigation shortcuts
alias cdh='cd ~'

# Better directory listings
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Safety guardrails (prompts before destructive operations)
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

alias myip='curl -fsS https://ifconfig.me && echo' # Quickly find public IP

# Reload the shell with a fresh .bashrc
alias srcbashrc='exec bash'

# ==============================================================================
# Functions
# ==============================================================================

# Print PATH entries line-by-line without spawning a subprocess
path() {
    printf '%s\n' "${PATH//:/$'\n'}"
}

# Show the 25 largest files/directories under a directory
bfile() {
    # Accept at most one directory argument
    (($# <= 1)) || {
        echo 'usage: bfile [directory]' >&2
        return 2
    }

    # Default to the current directory when no argument is given
    local dir=${1:-.}

    # Fail when the path does not exist
    if [[ ! -e $dir ]]; then
        printf "bfile: '%s' does not exist\n" "$dir" >&2
        return 1
    fi

    # Fail when the path exists but is not a directory
    if [[ ! -d $dir ]]; then
        printf "bfile: '%s' is not a directory\n" "$dir" >&2
        return 1
    fi

    # List sizes in human-readable form, largest first, and keep the top 25
    du -ah -- "$dir" | sort -hr | head -n 25
}

# Smart Archive Extractor (handles almost all zip/tar extensions)
extract() {
    if [[ -f $1 ]]; then
        case "$1" in
        *.tar.bz2) tar xjf "$1" ;;
        *.tar.gz) tar xzf "$1" ;;
        *.bz2) bunzip2 "$1" ;;
        *.rar) unrar x "$1" ;;
        *.gz) gunzip "$1" ;;
        *.tar) tar xf "$1" ;;
        *.tbz2) tar xjf "$1" ;;
        *.tgz) tar xzf "$1" ;;
        *.zip) unzip "$1" ;;
        *.Z) uncompress "$1" ;;
        *.7z) 7z x "$1" ;;
        *) printf "'%s' cannot be extracted via extract()\n" "$1" ;;
        esac
    else
        printf "'%s' is not a valid file\n" "$1"
    fi
}

# Create a directory and immediately move into it
mkcd() {
    mkdir -p "$1" && cd "$1"
}
