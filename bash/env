#!/bin/bash

# Source XDG base directories if exist.
if [[ -r $HOME/.config/user-dirs.dirs ]]; then
    source "$HOME/.config/user-dirs.dirs"
fi

# Respect paths already set by the session; fall back to XDG defaults.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Ensure the history directory exists on a fresh setup
[[ -d $XDG_STATE_HOME/bash ]] || mkdir -p -- "$XDG_STATE_HOME/bash"

export HISTFILE="$XDG_STATE_HOME"/bash/history

# ==============================================================================
# ENVIRONMENTAL VARIABLES
# ==============================================================================
export EDITOR='nvim' # Default text editor
export VISUAL='nvim'
export PAGER='less' # Preferred terminal pager
# export LANG='en_US.UTF-8'          # Force UTF-8 encoding
# export LC_ALL='en_US.UTF-8'

# ==============================================================================
# PATH
# ==============================================================================
# User binaries first, so tools installed there are visible to the module checks.
__path_add prepend "$HOME/.local/bin"
__path_add prepend "$HOME/bin"

# Tool modules: the filename is the command gate, and each module owns its
# environment variables and PATH entries. BASHRC_DIR is set by bashrc before
# this file is sourced.
__src_tool_modules "$BASHRC_DIR/bash/env.d"

# Toolbox has no command matching its directory name, so it is not a module.
__path_add append "$XDG_DATA_HOME/JetBrains/Toolbox/scripts"
