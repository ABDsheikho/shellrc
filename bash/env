#!/bin/bash

# Respect paths already set by the session; fall back to XDG defaults.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Ensure the history directory exists on a fresh setup
[[ -d $XDG_STATE_HOME/bash ]] || mkdir -p -- "$XDG_STATE_HOME/bash"

export HISTFILE="$XDG_STATE_HOME"/bash/history
export PARALLEL_HOME="$XDG_CONFIG_HOME"/parallel
export DOTNET_CLI_HOME="$XDG_DATA_HOME"/dotnet

# ==============================================================================
# PATH & ENVIRONMENTAL VARIABLES
# ==============================================================================
export EDITOR='nvim' # Default text editor
export VISUAL='nvim'
export PAGER='less' # Preferred terminal pager
# export LANG='en_US.UTF-8'          # Force UTF-8 encoding
# export LC_ALL='en_US.UTF-8'

# Append custom binaries to system PATH securely
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"
[[ -d "$HOME/bin" ]] && export PATH="$HOME/bin:$PATH"

export W3M_DIR="$XDG_DATA_HOME"/w3m
export RUSTUP_HOME="$XDG_DATA_HOME"/rustup
